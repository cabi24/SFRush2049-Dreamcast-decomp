+void SonicCarCollision(tShotInfoDC *shot)
+{
+    tCarData *car;
+    tCarData *our;
+    tModelData *m;
+    int i;
+    int dam;
+    float vec[3];
+    float vec2[3];
+    float dist;
+    float rad;
+    float radsq;
+    float mul;
+    float scale;
+    float pos[3];
+
+    our = &gGameCar[shot->slot];
+    scale = ObjInstanceList[shot->obj->mbIdx].scale;
+    rad = 4.0f * scale;
+    radsq = rad * rad;
+    if (scale <= 8.0f) {
+        mul = 1.0f;
+        dam = 800;
+    } else if (scale <= 20.0f) {
+        mul = 0.6000000238418579f;
+        dam = 400;
+    } else {
+        dam = 200;
+        mul = 0.5f;
+    }
+    pos[0] = shot->obj->mat.mat3.pos[0];
+    pos[1] = shot->obj->mat.mat3.pos[1];
+    pos[2] = shot->obj->mat.mat3.pos[2];
+    for (i = 0, car = gGameCar; i < gNumCars; i++, car++) {
+        if (shot->slot == car->slot || model[i].resurrect.moving_state != -1 ||
+            !car->collidable || (shot->slotDamaged & (1 << car->slot)))
+            continue;
+        vec[0] = car->dr_pos[0] - pos[0];
+        vec[1] = car->dr_pos[1] - pos[1];
+        vec[2] = car->dr_pos[2] - pos[2];
+        dist = vec[0] * vec[0] + vec[1] * vec[1] + vec[2] * vec[2];
+        if (dist <= radsq) {
+            shot->slotDamaged |= 1 << car->slot;
+            BattleDamage(our, car, dam);
+            m = &model[car->slot];
+            {
+                rad = sqrtf(dist);
+                vec2[2] = 330000.0f * (mul * (vec[2] / rad));
+                vec2[1] = mul * (330000.0f * (vec[1] / rad) + 66000.0f);
+                vec2[0] = 330000.0f * (mul * (vec[0] / rad));
+                BodyVector(vec2, vec, car->dr_uvs);
+                m->centerForce[0] += vec[0];
+                m->centerForce[1] += vec[1];
+                m->centerForce[2] += vec[2];
+                vec[1] = 0.0f;
+                m->centerMoment[0] += vec[0];
+                m->centerMoment[1] += vec[1];
+                m->centerMoment[2] += vec[2];
+
+            }
+        }
+    }
+}
