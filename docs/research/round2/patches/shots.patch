+/* Local minimum views: no shared layout changes. ElevateGun float loads/stores
+   9691A..972 prove yaw +3C8 and pitch +3C4. Collision 96D98 proves radius +10. */
+#define SHOT_YAW(c) (*(float *)((char *)(c) + 0x3c8))
+#define SHOT_PITCH(c) (*(float *)((char *)(c) + 0x3c4))
+#define SHOT_RADIUS(s) (*(float *)((char *)(s) + 0x10))
+extern float weaponOffsets[][13][3]; /* 9684C stride9C; body index times0C. */
+extern tZoidObjectDC ObjInstanceList[]; /* 96EAA stride58, 96EBA base+0C. */
+extern float _builtin_sqrtf(float);
