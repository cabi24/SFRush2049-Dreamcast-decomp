+enum {kViewMenuTrack=0,kTrackTypeCircuit=4,kTrackTypeTotals=5};
+enum {kViewRaceStats=0,kViewLapTimes,kViewAverageTimes,kViewGhostTimes,kViewBattleStats,kViewStuntStats,kViewStuntTotals,kViewObstacleStats,kViewCircuitStats,kViewTotalStats,kViewUnlockedTracks,kViewUnlockedCars,kViewUnlockedParts};
+void drawRaceStats(void);
