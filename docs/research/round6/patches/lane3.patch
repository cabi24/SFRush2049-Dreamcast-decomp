+
+void func_8C08931A(void)
+{
+ int pak;
+ tPlayerProfile **player;
+ for(pak=0;pak<8;pak++) {
+  if(!gControllerData[pak/2].attached) gNumPakPlayers[pak]=-4;
+  else if(!PS_PakInserted(pak)) gNumPakPlayers[pak]=-1;
+  else if(PS_PakDamaged(pak)) gNumPakPlayers[pak]=-2;
+  else if(PS_PakRumble(pak)) gNumPakPlayers[pak]=-3;
+  else {
+   gNumPakPlayers[pak]=0;
+   for(player=gPlayerFiles.head;player;player=(*player)->ll.next)
+    if((*(*player)->fileh)->pak==pak) gNumPakPlayers[pak]++;
+   if(gNumPakPlayers[pak]==0) gNumPakPlayers[pak]=0;
+  }
+ }
+}
