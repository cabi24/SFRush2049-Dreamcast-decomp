+    m->brake = 0.0f;
+    m->engtorque = 0.0f;
+    m->clutchtorque = 0.0f;
+    m->clutchangvel = 0.0f;
+    m->transratio = 0.0f;
+    m->totalratio = 0.0f;
+    m->dwtorque = 0.0f;
+    m->efdwinvmi = 0.0f;
+    m->dwangvel = 0.0f;
+
+}
+
+float CalcDrift(tModelData *m)
+{
+    float drift;
+    int susp;
+    drift = initTireDrift[m->tire_type][m->handling];
+    susp = initCarSuspensions[m->body_type];
+    if (susp == 0) drift += 0.050000001f;
+    else if (susp == 2) drift -= 0.050000001f;
+    return drift;
+}
+
+float CalcTireSideForce(tModelData *m)
+{
+    return initTireSideForce[m->tire_type];
+}
+
+float CalcOffroadTires(tModelData *m)
+{
+    if (m->tire_type == 4) return 0.75f;
+    if (m->tire_type == 3) return 0.5f;
+    if (m->tire_type == 1) return -0.25f;
+    if (m->tire_type == 2) return -0.5f;
+    return 0.0f;
+}
+
+float CalcMass(tModelData *m)
+{
+    return ((31.055901f * (initDurability[m->frame] - 0.40000001f) + initCarMass[m->body_type] + 31.055901f * gMassiveMass) * initTune[m->handling].weight_scale);
+}
+
+void initialize(tModelData *m)
+{
+    float *torque = m->torque;
+    INIT_EXTRA(m)->pitchangle = 0.0f;
+    torque[1] = 0.0f;
+    torque[0] = 0.0f;
+    m->torque[2] = 50.0f;
+    m->torque[3] = 50.0f;
+    m->dt = 0.0025f;
+    INIT_EXTRA(m)->brakeroll = 3.0f;
+    m->shifttime = 0.0f;
+    INIT_EXTRA(m)->thumpthreshold = 7500.0f;
+    m->thumpflag = 0;
+    m->f[0] = 0.0f;
+    m->f[1] = 0.0f;
+    m->f[2] = 0.0f;
+    m->m[0] = 0.0f;
+    m->m[1] = 0.0f;
+    m->m[2] = 0.0f;
+    m->a[0] = 0.0f;
+    m->a[1] = 0.0f;
+    m->a[2] = 0.0f;
+    m->aa[0] = 0.0f;
+    m->aa[1] = 0.0f;
+    m->aa[2] = 0.0f;
+    m->w[0] = 0.0f;
+    m->w[1] = 0.0f;
+    m->w[2] = 0.0f;
+    m->v[0] = 0.0f;
+    m->v[1] = 0.0f;
+    m->v[2] = 0.0f;
+    m->engangvel = 0.0f;
+    CopyUV(unitmatrix, m->uvs);
+    if (gSuperSpeed) {
+        m->uvs[0][0] = 1.00024998188018798828125f;
+        m->uvs[1][1] = 1.00024998188018798828125f;
+        m->uvs[2][2] = 1.00024998188018798828125f;
+    }
+    carsetup(m);
+    init_road(m);
+    init_collision(m);
+    m->crashflag = 0;
+    gGameCar[m->slot].battle.health = 800;
+    gGameCar[m->slot].battle.shoot = 0;
+    gGameCar[m->slot].battle.fadeState = 0;
+    gGameCar[m->slot].battle.defense.active = 0;
+    INIT_BATTLE_CARS[m->slot].pitch = 0.0f;
+    INIT_BATTLE_CARS[m->slot].yaw = 0.0f;
+    gGameCar[m->slot].crash_state = 0;
+    m->bodyForces = 0.0f;
+    m->bogState = 3;
+}
+
+void steer_constants(tModelData *m)
+{
+    m->steergain = 0.017453293f * (540.0f / INIT_CAR(m)->steerratio);
+    INIT_EXTRA(m)->trail = (INIT_CAR(m)->swtpg * INIT_CAR(m)->steerratio) / (m->weight * (INIT_CAR(m)->tireR[2][2] / INIT_EXTRA(m)->wheelbase));
+}
+
+void copy_tire_info(const DcInitTireInfo *tp1, DcInitTire *tp2)
+{
+    tp2->tradius = tp1->tradius;
+    tp2->springK = tp1->springK;
+    tp2->rubdamp = tp1->rubdamp;
+    tp2->cstiff = tp1->cstiff;
+    tp2->cfmax = tp1->cfmax;
+    tp2->invmi = tp1->invmi;
+}
+
+void tire_constants(tModelData *m, DcInitTire *tdes, float otw)
+{
+    tdes->zforce = 0.5f * (m->weight * otw / INIT_EXTRA(m)->wheelbase);
+    tdes->afmax = 3.0f * tdes->cfmax * tdes->zforce / tdes->cstiff;
+    tdes->k1 = tdes->cstiff / tdes->zforce;
+    tdes->k2 = tdes->k1 * tdes->k1 / (3.0f * tdes->cfmax);
+    tdes->k3 = (tdes->k1 * tdes->k1 * tdes->k1) / (27.0f * tdes->cfmax * tdes->cfmax);
+    tdes->l2 = 2.0f * tdes->k2;
+    tdes->l3 = 3.0f * tdes->k3;
+    tdes->m1 = 4.16f / tdes->cfmax;
+    tdes->m2 = 0.29411764f * (tdes->m1 * tdes->m1);
+    tdes->m3 = 0.021598273f * (tdes->m1 * tdes->m1 * tdes->m1);
+    tdes->m4 = 18181.819f;
+    tdes->patchy = 0.0f;
+}
