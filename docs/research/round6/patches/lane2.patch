+    case 2:
+        blt->x = odometerPos[gNumWindows - 1][p][0];
+        blt->y = odometerPos[gNumWindows - 1][p][1];
+        blt->left = 0;
+        blt->top = ((int)(carMileage / 5280.0f) % 10) * (blt->width / 2);
+        if ((int)(carMileage / 528.0f) % 10 == 9)
+            blt->top += flipAmount * (blt->width / 2);
