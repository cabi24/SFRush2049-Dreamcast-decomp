index 0000000..6abe51e
--- /dev/null
+++ b/src/unk_8C0260F0.c
@@ -0,0 +1,55 @@
+#include "packet_round6.h"
+
+/* Native packet rewrite. The preceding five mapped entries are not reconstructed. */
+void func_8C026104(int textureSet, int wide, unsigned int *packet)
+{
+    tPacketTexturesR6 *textures = &gTexDefPtrs[textureSet];
+    unsigned int *defaultContext = (unsigned int *)dcContextA;
+    for (;;) {
+        unsigned int kind = *packet & 0xe0000000;
+        if (kind == 0xe0000000) return;
+        switch (kind) {
+        case 0x80000000:
+            if (gBackwards && (*packet & 2)) packet[1] = 0;
+            else if (!gBackwards && (*packet & 1)) packet[1] = 0;
+            packet++;
+            break;
+        case 0xa0000000:
+            if ((signed short)*packet != -1) {
+                tPacketTextureR6 *tex = &textures->textures[(signed short)*packet];
+                unsigned int type = (*tex->context >> 24) & 7;
+                unsigned int mode;
+                if (type == 0) mode = 0;
+                else if (type == 2) mode = 1;
+                else mode = 2;
+                if (tex->flags & 0x20000) {
+                    *packet = (*packet & 0xff000000) | (mode << 16) | type | 0x1000300;
+                    packet++;
+                    *packet = (unsigned int)tex->inlineContext;
+                } else {
+                    *packet = (*packet & 0xff000000) | (mode << 16) | type | 0x300;
+                    packet++;
+                    *packet = (unsigned int)tex->context;
+                }
+            } else {
+                *packet &= 0xff000000;
+                packet++;
+                *packet = (unsigned int)defaultContext;
+            }
+            break;
+        case 0x20000000:
+        case 0:
+            {
+                unsigned int position = *packet & 0x10000000;
+                unsigned int uv = *packet & 0x08000000;
+                unsigned int color = *packet & 0x04000000;
+                if (!position) packet += 3;
+                if (!uv) packet += 2;
+                if (wide) { if (!color) packet += 3; }
+                else if (!color) packet++;
+            }
+            break;
+        }
+        packet++;
+    }
+}
