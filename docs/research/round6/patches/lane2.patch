+int animTrackMap(_tBlit *blt)
+{
+    int width,height,w,h,xOffset,yOffset;
+    int x,y,x1,y1,x2,p,i;
+    unsigned short *pixel;
+    if(Hidden(blt,gNumWindows>4 || !(gGameState&0x400000) || !gShowTrackMap)) return 1;
+    if(!(blt->animID&16)) return 1;
