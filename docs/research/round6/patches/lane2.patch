+unsigned char func_8C038FCC(float t, unsigned char *dest, char format)
+{
+    unsigned int hun;
+    unsigned int sec;
+    unsigned int min;
+
+    if (t < 0.0f)
+        t = 0.0f;
+    switch (format) {
+    case 'c':
+        sec = (unsigned int)t;
+        if (sec > 999)
+            sec = 999;
+        dest[0] = (sec / 100) % 10;
+        dest[1] = (sec / 10) % 10;
+        dest[2] = sec % 10;
+        dest[3] = 0;
+        return 3;
+    case 'f':
+        sec = (unsigned int)t;
+        min = sec / 60;
+        sec %= 60;
+        hun = (unsigned int)(100.0f * t) % 100;
+        dest[0] = (min / 10) % 10;
+        dest[1] = min % 10;
+        dest[2] = sec / 10;
+        dest[3] = sec % 10;
+        dest[4] = hun / 10;
+        dest[5] = hun % 10;
+        dest[6] = 0;
+        return 6;
+    }
+    return 0;
+}
