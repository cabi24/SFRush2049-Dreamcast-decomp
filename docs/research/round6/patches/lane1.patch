+        pos[0]=xyz[0][0];
+        pos[1]=xyz[0][1];
+        pos[2]=xyz[0][2];
+        xyz[0][0]=xyz[1][0];
+        xyz[0][1]=xyz[1][1];
+        xyz[0][2]=xyz[1][2];
