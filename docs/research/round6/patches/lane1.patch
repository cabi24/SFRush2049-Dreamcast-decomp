+tVisual *GrabEnvEntry(void)
+{
+    tVisual *v = gFreeVis;
+    if (!v) return 0;
+    gFreeVis = v->next;
+    if (++gEnvCount > gEnvCountMax) gEnvCountMax = gEnvCount;
+    v->next = 0;
+    v->index = 0;
+    v->objnum = -1;
+    v->slot = 0;
+    v->data = 0;
+    v->timeStamp = 0.0f;
+    v->func = 0;
