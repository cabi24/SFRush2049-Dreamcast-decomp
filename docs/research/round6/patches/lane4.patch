+static void _FindGhosts(int pak)
+{
+    dcHighSavedGhost **gh;
+    dcHighSavedGhost *g;
+    tPlayerProfile *p=(tPlayerProfile *)gGhostPlayer;
+    unsigned int existingGhostSize=0;
+    gPakGhosts[pak]=0;
+    if(!gControllerData[pak/2].attached) {gGhostStatus[pak]=-4;return;}
+    if(!PS_PakInserted(pak)) {gGhostStatus[pak]=-1;return;}
+    if(PS_PakDamaged(pak)) {gGhostStatus[pak]=-2;return;}
+    if(PS_PakRumble(pak)) {gGhostStatus[pak]=-3;return;}
+    gGhostStatus[pak]=0;
+    if(gRace==2) {
+        if(!GhostFileAvailable((tPlayerProfile **)&gGhostPlayer,pak,gTrackNum,gBackwards)) gGhostStatus[pak]=-5;
+        for(gh=highGhostHead;gh;gh=g->next) {
+            g=*gh;
+            if(g->fileh && ((dcHighFileView *)*g->fileh)->pak==pak && g->track==gTrackNum && g->backward==gBackwards &&
+                !strcmp((char *)g->name,(char *)p->name) && g->playerId[0]==p->id[0] && g->playerId[1]==p->id[1]) {
+                if(!gPakGhosts[pak] || g->finish > (*gPakGhosts[pak])->finish) {gPakGhosts[pak]=gh;gGhostStatus[pak]=1;}
+            }
+        }
+        if(gPakGhosts[pak]) existingGhostSize=((dcHighFileView *)*(*gPakGhosts[pak])->fileh)->blocks;
+        if(gBlocksNeeded > existingGhostSize+PS_GetFreeBlocks(pak)) {gPakGhosts[pak]=0;gGhostStatus[pak]=-5;}
+    }
+}
